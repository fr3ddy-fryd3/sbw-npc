root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 120
ktlint_function_signature_body_expression_wrapping = multiline
ktlint_standard_if-else-bracing = enabled
ktlint_standard_multiline-if-else = enabled
# Existing wildcard imports and long diagnostic strings do not affect control-flow formatting.
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_no-unused-imports = disabled
ktlint_standard_max-line-length = disabled
# Empty parameter arrows select Supplier rather than Function in NeoForge overloads.
ktlint_standard_function-literal = disabled
